# HERE
# ============================================================

def geocode_here(address):

    if not HERE_API_KEY:
        return {
            "provider": "here",
            "status": "NO_API_KEY"
        }

    provider = "here"

    cached = cache_get(provider, address)

    if cached:
        return cached

    url = (
        "https://geocode.search.hereapi.com/"
        "v1/geocode"
    )

    params = {
        "q": address,
        "apiKey": HERE_API_KEY,
        "lang": LANGUAGE,
        "in": f"countryCode:{COUNTRY_ISO3}",
        "limit": 1
    }

    try:
        response = session.get(
            url,
            params=params,
            timeout=20
        )

        data = response.json()

        items = data.get("items", [])

        if not items:
            result = {
                "provider": provider,
                "status": "NO_RESULT"
            }

            cache_set(provider, address, result)
            return result

        item = items[0]

        position = item.get("position", {})

        scoring = item.get("scoring", {})

        result = {
            "provider": provider,
            "status": "OK",
            "lat": float(position["lat"]),
            "lon": float(position["lng"]),
            "matched_address": item.get("title"),
            "precision": item.get(
                "resultType"
            ),
            "confidence": scoring.get(
                "queryScore"
            )
        }

        cache_set(provider, address, result)

        return result

    except Exception as e:
        return {
            "provider": provider,
            "status": "ERROR",
            "error": str(e)
        }


# ============================================================
# NOMINATIM / OPENSTREETMAP
# ============================================================

def geocode_nominatim(address):

    provider = "nominatim"

    cached = cache_get(provider, address)

    if cached:
        return cached

    url = (
        "https://nominatim.openstreetmap.org/"
        "search"
    )

    params = {
        "q": address,
        "format": "jsonv2",
        "addressdetails": 1,
        "limit": 1,
        "countrycodes": COUNTRY_ISO2.lower(),
        "accept-language": LANGUAGE
    }

    try:

        # Публічна політика Nominatim:
        # максимум 1 request / second.
        time.sleep(1.1)

        response = session.get(
            url,
            params=params,
            timeout=30
        )

        response.raise_for_status()

        data = response.json()

        if not data:
            result = {
                "provider": provider,
                "status": "NO_RESULT"
            }

            cache_set(provider, address, result)

            return result

        item = data[0]

        result = {
            "provider": provider,
            "status": "OK",
            "lat": float(item["lat"]),
            "lon": float(item["lon"]),
            "matched_address": item.get(
                "display_name"
            ),
            "precision": (
                item.get("addresstype")
                or item.get("type")
            ),
            "confidence": item.get(
                "importance"
            )
        }

        cache_set(provider, address, result)

        return result

    except Exception as e:
        return {
            "provider": provider,
            "status": "ERROR",
            "error": str(e)
        }


# ============================================================
# CONSENSUS
# ============================================================

def calculate_consensus(results):

    valid = [
        x for x in results
        if x.get("status") == "OK"
        and x.get("lat") is not None
        and x.get("lon") is not None
    ]

    if not valid:
        return {
            "consensus_provider": None,
            "consensus_lat": None,
            "consensus_lon": None,
            "agreement": "NO_RESULT",
            "support_count": 0,
            "provider_count": 0,
            "max_distance_m": None
        }

    if len(valid) == 1:

        point = valid[0]

        return {
            "consensus_provider": point["provider"],
            "consensus_lat": point["lat"],
            "consensus_lon": point["lon"],
            "agreement": "SINGLE_PROVIDER",
            "support_count": 1,
            "provider_count": 1,
            "max_distance_m": None
        }

    scores = {}

    for candidate in valid:

        distances = []

        for other in valid:

            if candidate["provider"] == other["provider"]:
                continue

            d = haversine(
                candidate["lat"],
                candidate["lon"],
                other["lat"],
                other["lon"]
            )

            distances.append(d)

        scores[candidate["provider"]] = (
            sum(distances) / len(distances)
        )

    # Medoid
    best_provider = min(
        scores,
        key=scores.get
    )

    best = next(
        x for x in valid
        if x["provider"] == best_provider
    )

    distances_from_best = []

    support = 0

    for item in valid:

        d = haversine(
            best["lat"],
            best["lon"],
            item["lat"],
            item["lon"]
        )

        distances_from_best.append(d)

        if d <= STRONG_DISTANCE_M:
            support += 1

    max_distance = max(distances_from_best)

    ratio = support / len(valid)

    if (
        len(valid) >= 3
        and ratio >= 0.75
    ):
        agreement = "HIGH"

    elif (
        len(valid) >= 2
        and max_distance <= MEDIUM_DISTANCE_M
    ):
        agreement = "MEDIUM"

    else:
        agreement = "LOW"

    return {
        "consensus_provider": best_provider,
        "consensus_lat": best["lat"],
        "consensus_lon": best["lon"],
        "agreement": agreement,
        "support_count": support,
        "provider_count": len(valid),
        "max_distance_m": round(
            max_distance,
            2
        )
    }


# ============================================================
# ОБРОБКА ОДНІЄЇ АДРЕСИ
# ============================================================

def process_address(address, ref_lat=None, ref_lon=None):

    normalized = normalize_address(address)

    results = [
        geocode_google(normalized),
        geocode_here(normalized),
        geocode_mapbox(normalized)
    ]

    if USE_NOMINATIM:
        results.append(
            geocode_nominatim(normalized)
        )

    consensus = calculate_consensus(results)

    row = {
        "address_original": address,
        "address_normalized": normalized
    }

    # --------------------------------------------------------
    # PROVIDER RESULTS
    # --------------------------------------------------------

    for result in results:

        provider = result["provider"]

        row[f"{provider}_status"] = result.get(
            "status"
        )

        row[f"{provider}_lat"] = result.get(
            "lat"
        )

        row[f"{provider}_lon"] = result.get(
            "lon"
        )

        row[f"{provider}_address"] = result.get(
            "matched_address"
        )

        row[f"{provider}_precision"] = result.get(
            "precision"
        )

        row[f"{provider}_confidence"] = result.get(
            "confidence"
        )

        row[f"{provider}_address_similarity"] = (
            address_similarity(
                normalized,
                result.get("matched_address")
            )
        )

    # --------------------------------------------------------
    # DISTANCE TO CONSENSUS
    # --------------------------------------------------------

    if consensus["consensus_lat"] is not None:

        for result in results:

            if result.get("status") == "OK":

                distance = haversine(
                    result["lat"],
                    result["lon"],
                    consensus["consensus_lat"],
                    consensus["consensus_lon"]
                )

                row[
                    f"{result['provider']}_consensus_distance_m"
                ] = round(distance, 2)

                row[
                    f"{result['provider']}_outlier"
                ] = (
                    distance > OUTLIER_DISTANCE_M
                )

    # --------------------------------------------------------
    # GROUND TRUTH
    # --------------------------------------------------------

    has_reference = (
        ref_lat is not None
        and ref_lon is not None
        and not pd.isna(ref_lat)
        and not pd.isna(ref_lon)
    )

    if has_reference:

        ref_lat = float(ref_lat)
        ref_lon = float(ref_lon)

        row["ref_lat"] = ref_lat
        row["ref_lon"] = ref_lon

        for result in results:

            if result.get("status") == "OK":

                error = haversine(
                    result["lat"],
                    result["lon"],
                    ref_lat,
                    ref_lon
                )

                row[
                    f"{result['provider']}_error_m"
                ] = round(error, 2)

    row.update(consensus)

    return row


# ============================================================
# PROVIDER BENCHMARK
# ============================================================

def create_provider_summary(df):

    providers = [
        "google",
        "here",
        "mapbox",
        "nominatim"
    ]

    rows = []

    for provider in providers:

        status_column = f"{provider}_status"

        if status_column not in df.columns:
            continue

        total = len(df)

        successful = (
            df[status_column] == "OK"
        ).sum()

        summary = {
            "provider": provider,
            "total_addresses": total,
            "successful": successful,
            "success_rate_pct": round(
                successful / total * 100,
                2
            ) if total else 0
        }

        consensus_column = (
            f"{provider}_consensus_distance_m"
        )

        if consensus_column in df.columns:

            values = pd.to_numeric(
                df[consensus_column],
                errors="coerce"
            ).dropna()

            if not values.empty:

                summary[
                    "median_consensus_distance_m"
                ] = round(values.median(), 2)

                summary[
                    "mean_consensus_distance_m"
                ] = round(values.mean(), 2)

        error_column = f"{provider}_error_m"

        if error_column in df.columns:

            errors = pd.to_numeric(
                df[error_column],
                errors="coerce"
            ).dropna()

            if not errors.empty:

                summary["median_error_m"] = round(
                    errors.median(),
                    2
                )

                summary["mean_error_m"] = round(
                    errors.mean(),
                    2
                )

                summary["p90_error_m"] = round(
                    errors.quantile(0.90),
                    2
                )

                summary["within_25m_pct"] = round(
                    (errors <= 25).mean() * 100,
                    2
                )

                summary["within_50m_pct"] = round(
                    (errors <= 50).mean() * 100,
                    2
                )

                summary["within_100m_pct"] = round(
                    (errors <= 100).mean() * 100,
                    2
                )

                summary["within_250m_pct"] = round(
                    (errors <= 250).mean() * 100,
                    2
                )

        rows.append(summary)

    summary_df = pd.DataFrame(rows)

    if "median_error_m" in summary_df.columns:

        summary_df = summary_df.sort_values(
            [
                "median_error_m",
                "success_rate_pct"
            ],
            ascending=[True, False]
        )

    elif (
        "median_consensus_distance_m"
        in summary_df.columns
    ):

        summary_df = summary_df.sort_values(
            [
                "median_consensus_distance_m",
                "success_rate_pct"
            ],
            ascending=[True, False]
        )

    return summary_df


# ============================================================
# MAIN
# ============================================================

def main():

    init_cache()

    print("Читання:", INPUT_FILE)

    if INPUT_FILE.suffix.lower() == ".csv":

        df = pd.read_csv(
            INPUT_FILE,
            dtype=str
        )

    else:

        df = pd.read_excel(
            INPUT_FILE
        )

    if ADDRESS_COLUMN not in df.columns:
        raise ValueError(
            f"Не знайдена колонка '{ADDRESS_COLUMN}'"
        )

    has_reference = (
        REFERENCE_LAT_COLUMN in df.columns
        and REFERENCE_LON_COLUMN in df.columns
    )

    results = []

    total = len(df)

    for index, row in df.iterrows():

        address = row[ADDRESS_COLUMN]

        if pd.isna(address):
            continue

        print(
            f"[{index + 1}/{total}] {address}"
        )

        ref_lat = None
        ref_lon = None

        if has_reference:

            ref_lat = row[
                REFERENCE_LAT_COLUMN
            ]

            ref_lon = row[
                REFERENCE_LON_COLUMN
            ]

        result = process_address(
            address,
            ref_lat,
            ref_lon
        )

        results.append(result)

    result_df = pd.DataFrame(results)

    summary_df = create_provider_summary(
        result_df
    )

    # --------------------------------------------------------
    # AGREEMENT SUMMARY
    # --------------------------------------------------------

    if "agreement" in result_df.columns:

        agreement_summary = (
            result_df["agreement"]
            .value_counts(dropna=False)
            .reset_index()
        )

        agreement_summary.columns = [
            "agreement",
            "count"
        ]

    else:

        agreement_summary = pd.DataFrame()

    # --------------------------------------------------------
    # EXCEL
    # --------------------------------------------------------

    OUTPUT_FILE.parent.mkdir(
        parents=True,
        exist_ok=True
    )

    with pd.ExcelWriter(
        OUTPUT_FILE,
        engine="openpyxl"
    ) as writer:

        result_df.to_excel(
            writer,
            sheet_name="results",
            index=False
        )

        summary_df.to_excel(
            writer,
            sheet_name="provider_summary",
            index=False
        )

        agreement_summary.to_excel(
            writer,
            sheet_name="agreement_summary",
            index=False
        )

    print()
    print("ГОТОВО")
    print(OUTPUT_FILE)

    print()
    print("Рейтинг провайдерів:")
    print(summary_df.to_string(index=False))


if __name__ == "__main__":
    main()
